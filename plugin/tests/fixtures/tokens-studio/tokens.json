{
  "$metadata": { "tokenSetOrder": ["core", "Scheme/Light", "Scheme/Dark"] },
  "core": {
    "post": {
      "core": {
        "color": {
          "black": { "$type": "color", "$value": "#000000" }
        },
        "spacing": {
          "4": { "$type": "spacing", "$value": "16px" },
          "flex": { "$type": "spacing", "$value": "auto" }
        },
        "font-weight": {
          "bold": { "$type": "fontWeights", "$value": "700" }
        },
        "line-height": {
          "loose": { "$type": "lineHeights", "$value": "150%" }
        },
        "scheme-name": { "$type": "text", "$value": "light" }
      }
    }
  },
  "Scheme/Light": {
    "post": {
      "scheme": {
        "color": {
          "bg": { "$type": "color", "$value": "#FFFFFF" },
          "fg": { "$type": "color", "$value": "{post.core.color.black}" },
          "input-bg": { "$type": "color", "$value": "#EEEEEE" }
        }
      }
    }
  },
  "Scheme/Dark": {
    "post": {
      "scheme": {
        "color": {
          "bg": { "$type": "color", "$value": "#000000" },
          "fg": { "$type": "color", "$value": "#FFFFFF" }
        }
      }
    }
  }
}
